rules_version = '2';

// All scene reads/writes are server-mediated through the Go backend's Admin SDK
// (which bypasses these rules). Clients never touch Firestore directly, so deny
// all direct client access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
