# Copy to backend/.env for local dev (loaded manually or via your shell/direnv).
# In production these are set as Cloud Run env vars / secrets.

# HTTP port the Go service listens on (Cloud Run sets this automatically).
PORT=8080

# Symmetric HS256 secret used to sign Go-issued JWTs. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# Firebase / GCP project that owns Auth, Firestore, and Storage.
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID

# Firebase Storage bucket (e.g. my-project.firebasestorage.app or *.appspot.com).
STORAGE_BUCKET=REPLACE_WITH_STORAGE_BUCKET

# Comma-separated allowlist of admin emails (or UIDs). Only these Firebase users
# receive a role:admin JWT from POST /auth/admin.
ADMIN_ALLOWLIST=you@example.com

# --- Credentials ---
# In production on Cloud Run, credentials come from the attached service account
# (Application Default Credentials) — leave GOOGLE_APPLICATION_CREDENTIALS unset.
# For local dev against REAL Firebase, point ADC at a service account key:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# --- Local development modes ---
# In-memory store, no Firebase at all (guest/relay flows only; admin auth won't
# work). Persistence is ON by default; set this only for pure frontend dev.
# DISABLE_PERSISTENCE=true

# Emulator suite (run `firebase emulators:start`). Any of these implies "no
# credentials needed". Set all three for full local auth + persistence.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8081
# STORAGE_EMULATOR_HOST=localhost:9199
