{
  "hosting": [
    {
      "target": "web",
      "public": "frontend/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "/auth{,/**}", "run": { "serviceId": "phil-canvas-backend", "region": "northamerica-northeast2" } },
        { "source": "/rooms{,/**}", "run": { "serviceId": "phil-canvas-backend", "region": "northamerica-northeast2" } },
        { "source": "/scenes{,/**}", "run": { "serviceId": "phil-canvas-backend", "region": "northamerica-northeast2" } },
        { "source": "/", "destination": "/index.html" },
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://firebasestorage.googleapis.com; font-src 'self' data:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebasestorage.googleapis.com https://apis.google.com wss://*.run.app; frame-src https://*.firebaseapp.com https://accounts.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
            }
          ]
        }
      ]
    }
  ],
  "storage": {
    "rules": "infra/firebase/storage.rules"
  },
  "firestore": {
    "rules": "infra/firebase/firestore.rules"
  },
  "emulators": {
    "auth": { "port": 9099, "host": "0.0.0.0" },
    "firestore": { "port": 8081, "host": "0.0.0.0" },
    "storage": { "port": 9199, "host": "0.0.0.0" },
    "ui": { "enabled": true, "port": 4000, "host": "0.0.0.0" },
    "hub": { "port": 4400, "host": "0.0.0.0" },
    "logging": { "port": 4500, "host": "0.0.0.0" },
    "singleProjectMode": true
  }
}
