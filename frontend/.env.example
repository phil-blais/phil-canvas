# Copy to frontend/.env.local for local dev. Only VITE_-prefixed vars are exposed
# to client code. Do NOT put secrets here — everything here ships to the browser.

# Backend (Cloud Run) origin. Two roles:
#   - dev: target for the Vite proxy (see vite.config.ts); usually the default.
#   - prod builds: the browser opens the relay WebSocket at this origin directly,
#     because Firebase Hosting does not proxy WebSocket upgrades. Set it to the
#     terraform `backend_url` output (e.g. https://phil-canvas-backend-xxxx.run.app).
VITE_BACKEND_ORIGIN=http://localhost:8080

# Firebase Storage media endpoint (the app percent-encodes the object path and
# appends ?alt=media; read access is granted by storage.rules on public/**).
# e.g. https://firebasestorage.googleapis.com/v0/b/<bucket>/o
VITE_PUBLISHED_BASE_URL=REPLACE_WITH_STORAGE_MEDIA_BASE_URL

# Firebase web app config (safe to expose; these identify the project, not secrets).
VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
VITE_FIREBASE_APP_ID=REPLACE_ME
