# Local dev defaults, auto-loaded by `vite` (dev mode). Points at the Dockerized
# Firebase emulators (see docs/dev.md). None of these are secrets.

VITE_BACKEND_ORIGIN=http://localhost:8080

# Firebase web config — for the emulator, the project id matters; the rest are
# placeholders (any non-empty api key enables admin sign-in).
VITE_FIREBASE_API_KEY=demo-canvas-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-canvas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-canvas
VITE_FIREBASE_APP_ID=demo-canvas-app-id

# Route Firebase Auth to the emulator.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099

# Read published scene/files from the Storage emulator.
VITE_PUBLISHED_BASE_URL=http://localhost:9199/v0/b/demo-canvas.appspot.com/o
